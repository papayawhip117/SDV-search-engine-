{
  "name": "sdv-search-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy Stardew Valley search engine and cited-facts assistant, built from the Stardew Valley Wiki with source attribution for every fact.",
  "author": "Papaya",
  "keywords": [
    "stardew-valley",
    "search-engine",
    "sqlite",
    "mediawiki",
    "rag"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/papayawhip117/SDV-search-engine-.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node src/web/server.js",
    "collect": "node src/collect/collectCrops.js",
    "import": "node src/collect/importBrowserFiles.js",
    "build-db": "node src/db/buildDatabase.js",
    "crops": "node src/cli/listCrops.js",
    "profit": "node src/cli/profit.js",
    "search": "node src/cli/search.js",
    "item": "node src/cli/item.js",
    "fish": "node src/cli/fish.js",
    "artisan": "node src/cli/artisan.js",
    "cook": "node src/cli/cook.js",
    "craft": "node src/cli/craft.js",
    "gifts": "node src/cli/gifts.js",
    "ask": "node src/cli/ask.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
